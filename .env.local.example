# TMDB API
TMDB_API_KEY=your_tmdb_api_key_here

# Supabase Configuration (get these from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (for server-side only, NEVER expose to client)
# Get this from Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
